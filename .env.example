# --- Database ---------------------------------------------------------------
# When deployed by SEAD CDS, an attached shared Connection supplies these; the
# portal injects them and CDS_DB_PREFIX names which attachment to read. Nothing
# below needs to be set on the Run Configuration.
#
#   CDS_DB_PREFIX=WEATHER
#   WEATHER_URI, or WEATHER_HOST / WEATHER_PORT / WEATHER_DB / WEATHER_USER / WEATHER_PASSWORD
#
# For local runs, use either of the fallbacks below instead.

# Option A: a single libpq connection string (takes precedence if set).
# DATABASE_URL=postgresql://user:password@localhost:5432/weather

# Option B: individual components (used when DATABASE_URL is not set).
PGHOST=localhost
PGPORT=5432
PGDATABASE=weather
PGUSER=postgres
PGPASSWORD=postgres
# PGSSLMODE=prefer
